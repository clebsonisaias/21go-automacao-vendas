# ===== Franquia / Power CRM =====
POWERCRM_FORM_CODE=
POWERCRM_CONSULTANT_CODE=

# URL pública do site (links de pagamento e vistoria enviados por WhatsApp)
NEXT_PUBLIC_APP_URL=https://21go.seg.br

# ===== Mercado Pago (Pix da taxa de adesão) =====
# Token PRIVADO da aplicação (Suas integrações → Credenciais). Nunca vai ao navegador.
MP_ACCESS_TOKEN=
# "Assinatura secreta" do webhook (Suas integrações → Webhooks). Obrigatória para validar x-signature.
MP_WEBHOOK_SECRET=
# Validade do Pix (ISO-8601, entre 30 min e 30 dias). Padrão: PT1H
MP_PIX_EXPIRATION=PT1H
# E-mail usado na cobrança quando o cliente não informou um
MP_FALLBACK_PAYER_EMAIL=

# ===== Segurança =====
# Assina a cotação (impede alterar o valor da adesão no navegador). Gere com: openssl rand -hex 32
QUOTE_SIGNING_SECRET=
# Assina o cookie do painel admin. Gere com: openssl rand -hex 32
SESSION_SECRET=
# Painel /admin (sem ADMIN_PASSWORD o painel fica BLOQUEADO — não existe senha padrão)
ADMIN_USER=admin
ADMIN_PASSWORD=

# ===== WhatsApp (CITchat / AtendeHub) =====
CITCHAT_GATEWAY_URL=
CITCHAT_GATEWAY_TOKEN=
ATENDEHUB_URL=
ATENDEHUB_API_KEY=
ATENDEHUB_CANAL_ID=

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== CRM 21 Go (opcional — sem credenciais padrão no código) =====
CRM_BASE_URL=
CRM_EMAIL=
CRM_PASSWORD=
CRM_PIPE_ID=
CRM_PHASE_COTACOES_RECEBIDAS=

# ===== Hinova SGA (área do associado) =====
HINOVA_API_BASE_URL=
HINOVA_CODIGO_ASSOCIACAO=
HINOVA_CODIGO_SEGURANCA=

# ===== IA (opcionais) =====
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== Dados públicos exibidos no site =====
NEXT_PUBLIC_FRANQUIA_WHATSAPP=
NEXT_PUBLIC_FRANQUIA_NOME=
NEXT_PUBLIC_FRANQUIA_EMAIL=
NEXT_PUBLIC_FRANQUIA_HORARIO=
NEXT_PUBLIC_FRANQUIA_CNPJ=

# Pasta dos cadastros (monte um volume persistente do Coolify aqui). Padrão: ./data
DATA_DIR=/app/data
